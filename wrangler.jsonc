/**
 * The deployment, as code.
 *
 * Paperweight is a folder of static files, so this is an assets-only Worker:
 * no script, just the `out/` directory that `pnpm build` produces, served from
 * Cloudflare's edge. Response headers, including the Content-Security-Policy,
 * come from `out/_headers`, which `scripts/write-headers.mjs` writes after
 * every build.
 *
 * Deploys run from CI (`.github/workflows/ci.yml`) with `wrangler deploy`.
 * `pnpm preview` serves the same build locally through `wrangler dev`, with
 * the same routing and the same headers, and `pnpm test:e2e:deploy` runs the
 * browser suite against exactly that.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "paperweight",
  "compatibility_date": "2026-09-08",
  "assets": {
    "directory": "./out",
    // An unknown path gets the exported 404 page with a 404 status. The app
    // is a single route, so there is nothing to rewrite to index.html.
    "not_found_handling": "404-page"
  },
  /*
   * The site's own domain.
   *
   * A custom domain, not a route: Cloudflare then owns the DNS record and the
   * certificate, and there is no zone-level routing to keep in step. The
   * apex only — `www` is a redirect rule in the dashboard rather than a
   * second custom domain, because a second custom domain would serve the
   * same bytes at a second address and leave two of everything for a crawler
   * to choose between.
   *
   * This requires the zone to be in the same Cloudflare account. Until it
   * is, `wrangler deploy` fails on this block rather than deploying without
   * the domain, which is the right way round: a deploy that silently drops
   * the domain looks exactly like one that worked.
   */
  "routes": [{ "pattern": "paperweightpdf.com", "custom_domain": true }],

  // Kept on: this is where every preview deployment lives, and CI posts the
  // preview URL on pull requests. Production answers on both names, and the
  // absolute canonical in `src/site.ts` is what tells an index which one is
  // the site.
  "workers_dev": true,
  "preview_urls": true
}
